generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Umkm {
  id               Int     @id @default(autoincrement())
  nama             String? @db.VarChar(100)
  nama_usaha       String  @db.VarChar(255)
  produk           String? @db.VarChar(255)
  kategori         String  @db.VarChar(100)
  alamat           String? @db.VarChar(255)
  rt               Int     @default(0)
  rw               Int     @default(0)
  status_nib       String  @default("") @db.VarChar(50)
  status_pelatihan String  @default("") @db.VarChar(50)
  desil            Int     @default(0)
  status_validasi  String  @default("") @db.VarChar(50)
  kecamatan        String  @default("Tawang") @db.VarChar(100)
  tahun_laporan    Int     @default(0)
  latitude         Float   @default(-7.335)
  longitude        Float   @default(108.222)
  url              String? @db.VarChar(500)

  @@map("umkm")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  nama      String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@map("admin")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
